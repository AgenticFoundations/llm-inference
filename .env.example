# Connect to your existing Ollama server. This project never launches or stops Ollama.
MODELS_CONFIG=config/models.json
OLLAMA_PORT=11434

# Loopback-only published ports. Native Ollama also binds to loopback.
GATEWAY_PORT=4000
EDGE_PORT=4080
STARTUP_TIMEOUT=240

# make setup generates these once. Keep the salt and DB password across restarts.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
POSTGRES_PASSWORD=

# Explicit image versions; upgrades are deliberate. Digests can also be used.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.108.2
POSTGRES_IMAGE=postgres:17.6-alpine
NGINX_IMAGE=nginx:1.28.0-alpine
